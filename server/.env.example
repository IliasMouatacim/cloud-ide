PORT=3001
JWT_SECRET=change-this-to-a-secure-random-string
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Set to enable persistent storage; required in production.
# DATABASE_URL=postgresql://ide:your-password@localhost:5432/cloud_ide
REDIS_URL=redis://localhost:6379
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Host shells share the server filesystem: enable only for trusted local development.
ENABLE_HOST_TERMINAL=false
# Production JWT_SECRET must be at least 32 characters.
# CLIENT_URL may contain comma-separated exact browser origins.
